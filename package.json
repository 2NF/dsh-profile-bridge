{
  "name": "dsh-profile-bridge",
  "version": "0.1.0",
  "description": "Make the DeepSeek Harness Desktop app use an existing plugin profile: one-click switch (directory link) with one-click revert.",
  "license": "MIT",
  "author": "",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "profile",
    "desktop"
  ],
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
